# LLM
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
OPENAI_API_KEY=
# Set an API model available to your account before selecting openai.
OPENAI_MODEL=gpt-6-luna
# Optional; must be supported by the chosen model.
OPENAI_REASONING_EFFORT=low
DEEPSEEK_THINKING=false
# Total HTTP request deadline; ambiguous cost stays reserved after timeout.
MODEL_REQUEST_TIMEOUT_S=120

# Runtime account: grant SELECT only.
DB_USER=mimic_reader
DB_PASS=change-me-reader
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mimiciv

# Loader/admin account used only by build_mimic_mini.py.
DB_LOADER_USER=postgres
DB_LOADER_PASS=change-me-admin

# Omit MIMIC_DATA_DIR to use data/raw/mimic-iv-3.1 inside this project.
# MIMIC_DATA_DIR=D:/path/to/mimic-iv-3.1
# CHROMA_DIR=D:/path/to/chroma
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
QUERY_TIMEOUT_MS=15000
LOCK_TIMEOUT_MS=2000
MAX_QUERY_ROWS=1000
MAX_EVAL_ROWS=10000
ICD_MAX_DISTANCE=0.90
SCHEMA_MAX_DISTANCE=0.95
EXAMPLE_MAX_DISTANCE=0.85
SEND_RESULTS_TO_LLM=false
