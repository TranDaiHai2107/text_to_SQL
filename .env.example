# LLM
GROQ_API_KEY=
LLM_MODEL=qwen/qwen3.8-27b

# Runtime account: grant SELECT only.
DB_USER=mimic_reader
DB_PASS=change-me-reader
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mimiciv

# Loader/admin account used only by build_mimic_mini.py.
DB_LOADER_USER=postgres
DB_LOADER_PASS=change-me-admin

MIMIC_DATA_DIR=D:/path/to/mimic-iv-3.1
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
QUERY_TIMEOUT_MS=15000
LOCK_TIMEOUT_MS=2000
MAX_QUERY_ROWS=1000
MAX_EVAL_ROWS=10000
ICD_MAX_DISTANCE=0.90
SCHEMA_MAX_DISTANCE=0.95
EXAMPLE_MAX_DISTANCE=0.85
SEND_RESULTS_TO_LLM=false
