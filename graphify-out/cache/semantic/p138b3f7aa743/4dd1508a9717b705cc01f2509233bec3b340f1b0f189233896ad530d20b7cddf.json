{"nodes": [{"id": "paper_baseline_2026_eacl_long_64_clinsql_paper", "label": "Patient-Similarity Cohort Reasoning in Clinical Text-to-SQL (ClinSQL, EACL 2026)", "file_type": "paper", "source_file": "paper baseline/2026.eacl-long.64.pdf", "source_location": "pp.1367-1412", "source_url": null, "captured_at": null, "author": "Yifei Shen, Yilun Zhao, Justice Ou, Tinglin Huang, Arman Cohan", "contributor": null}, {"id": "paper_baseline_2026_eacl_long_64_clinsql_benchmark", "label": "CLINSQL Benchmark (633 expert-annotated tasks)", "file_type": "concept", "source_file": "paper baseline/2026.eacl-long.64.pdf", "source_location": "Abstract, Sec 3, Table 3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Prior EHR text-to-SQL datasets (MIMICSQL, EHRSQL) emphasize single-patient or statistical retrieval; CLINSQL targets patient-similarity cohort reasoning, temporal windows, ICD coding, and multi-table joins. Split Easy 190 / Medium 254 / Hard 189."}, {"id": "paper_baseline_2026_eacl_long_64_mimic_iv_v3_1", "label": "MIMIC-IV v3.1 (BigQuery physionet-data.mimiciv_3_1_hosp / icu)", "file_type": "concept", "source_file": "paper baseline/2026.eacl-long.64.pdf", "source_location": "Sec 3, Appendix P", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "paper_baseline_2026_eacl_long_64_patient_similarity_cohort_reasoning", "label": "Patient-Similarity Cohort Reasoning", "file_type": "rationale", "source_file": "paper baseline/2026.eacl-long.64.pdf", "source_location": "Sec 1-2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Real clinical questions compare an anchor patient against similar patients under demographic, coding and temporal constraints rather than retrieving a single patient's record."}, {"id": "paper_baseline_2026_eacl_long_64_six_clinical_scenarios", "label": "Six Clinical Scenario Families (Demographics, Vitals, Labs, Meds, Diagnostic Procedures, Diagnosis & Outcomes)", "file_type": "concept", "source_file": "paper baseline/2026.eacl-long.64.pdf", "source_location": "Table 2", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "paper_baseline_2026_eacl_long_64_difficulty_levels", "label": "Difficulty Stratification (Easy 30% / Medium 40% / Hard 30%)", "file_type": "concept", "source_file": "paper baseline/2026.eacl-long.64.pdf", "source_location": "Sec 3.4", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "paper_baseline_2026_eacl_long_64_construction_pipeline", "label": "CLINSQL Construction Pipeline (query, SQL, guideline annotation, validation)", "file_type": "concept", "source_file": "paper baseline/2026.eacl-long.64.pdf", "source_location": "Figure 2, Sec 3.1-3.4, Appendix N", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Selected anchor patients are removed from the database before evaluation to prevent data contamination."}, {"id": "paper_baseline_2026_eacl_long_64_sql_rubric_tree", "label": "SQL Evaluation Rubric Tree (Cohort Construction, Medical Concept, Database Integration, Clinical Analytics)", "file_type": "concept", "source_file": "paper baseline/2026.eacl-long.64.pdf", "source_location": "Figure 3, Sec 3.3", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "paper_baseline_2026_eacl_long_64_results_rubric_tree", "label": "Results Validation Rubric Tree (Output Format Compliance, Clinical Value Validation)", "file_type": "concept", "source_file": "paper baseline/2026.eacl-long.64.pdf", "source_location": "Figure 4, Sec 4.2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Plausible bands admit clinically equivalent answers while acceptable bands tighten tolerance, allowing alternative valid SQL formulations."}, {"id": "paper_baseline_2026_eacl_long_64_critical_first_score_aggregation", "label": "Critical-First Score Aggregation (Algorithm 1)", "file_type": "rationale", "source_file": "paper baseline/2026.eacl-long.64.pdf", "source_location": "Algorithm 1, Appendix N.4", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Any failed critical child collapses the parent to 0; non-critical children contribute via weighted average (weights 1-3); sequential nodes short-circuit after a failure so downstream judgments don't mask upstream defects."}, {"id": "paper_baseline_2026_eacl_long_64_sql_score", "label": "SQL Score (rubric-based SQL analysis)", "file_type": "concept", "source_file": "paper baseline/2026.eacl-long.64.pdf", "source_location": "Sec 4.1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "paper_baseline_2026_eacl_long_64_execution_score", "label": "Execution Score (rubric-based CSV result evaluation)", "file_type": "concept", "source_file": "paper baseline/2026.eacl-long.64.pdf", "source_location": "Sec 4.2", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "paper_baseline_2026_eacl_long_64_gpt5_llm_judge", "label": "GPT-5 LLM-as-Judge (leaf-level binary decisions with rationales)", "file_type": "concept", "source_file": "paper baseline/2026.eacl-long.64.pdf", "source_location": "Sec 4.1, Appendix O Figs 25-26", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Chosen for strong instruction following and long-context capacity to compare rubric text, gold SQL and schema hints; validated by a human-GPT agreement study (Appendix K)."}, {"id": "paper_baseline_2026_eacl_long_64_cot_self_refinement", "label": "Chain-of-Thought prompting with up to two self-refinement rounds", "file_type": "concept", "source_file": "paper baseline/2026.eacl-long.64.pdf", "source_location": "Sec 5.1, Appendix D Figs 15-16, Appendix J", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Many models have low first-pass execution success and one correction round is insufficient; refinement feeds question, prior SQL and BigQuery error with minimal-edit instructions."}, {"id": "paper_baseline_2026_eacl_long_64_direct_output_prompting", "label": "Direct Output prompting regime", "file_type": "concept", "source_file": "paper baseline/2026.eacl-long.64.pdf", "source_location": "Sec 5.1, Figs 17-18", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "paper_baseline_2026_eacl_long_64_schema_hinted_inference", "label": "Schema-Hinted CoT Inference (ICD filters + expected output columns)", "file_type": "concept", "source_file": "paper baseline/2026.eacl-long.64.pdf", "source_location": "Sec 5.4, Table 5, Appendix F", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Motivated by error analysis showing cohort drift and schema mismatch dominate; hints extracted from gold SQL ICD codes and gold result header. GPT-5-mini validation execution rises to 82.74/85.85/77.03 on Easy/Medium/Hard."}, {"id": "paper_baseline_2026_eacl_long_64_error_taxonomy", "label": "Error Taxonomy (Cohort specification & coding 54%, Output schema & formatting 24%, Aggregation & clinical statistics 14%)", "file_type": "concept", "source_file": "paper baseline/2026.eacl-long.64.pdf", "source_location": "Sec 5.3, Appendix C", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "paper_baseline_2026_eacl_long_64_main_results", "label": "Main Results: GPT-5-mini 74.7% test exec; DeepSeek-R1 69.2% best open-source; Gemini-2.5-Pro 85.5% Easy to 67.2% Hard", "file_type": "concept", "source_file": "paper baseline/2026.eacl-long.64.pdf", "source_location": "Table 4, Sec 5.2", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "paper_baseline_2026_eacl_long_64_human_gpt_agreement", "label": "Human-GPT Agreement Study (100 samples) and Inter-Anno