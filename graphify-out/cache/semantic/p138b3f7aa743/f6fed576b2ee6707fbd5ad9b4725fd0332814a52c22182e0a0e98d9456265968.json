{"nodes": [{"id": "paper_baseline_2026_acl_long_116_sde_sql", "label": "SDE-SQL: Self-Driven Exploration with SQL Probes (ACL 2026)", "file_type": "paper", "source_file": "paper baseline/2026.acl-long.116.pdf", "source_location": "p.2507", "source_url": null, "captured_at": null, "author": "Wenxuan Xie, Yaxun Dai, Wenhao Jiang", "contributor": null}, {"id": "paper_baseline_2026_acl_long_116_self_driven_exploration", "label": "Self-Driven Exploration", "file_type": "rationale", "source_file": "paper baseline/2026.acl-long.116.pdf", "source_location": "Sec 1, 3.2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Static pre-processed schema context is insufficient for messy real databases with duplicate-meaning columns and differing value formats; letting the LLM dynamically query the database at inference is argued to be the fundamental fix rather than sampling many candidates."}, {"id": "paper_baseline_2026_acl_long_116_sql_probes", "label": "SQL Probes", "file_type": "concept", "source_file": "paper baseline/2026.acl-long.116.pdf", "source_location": "Sec 3.2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Auxiliary SQL queries executed to gather NULL/Not NULL evidence about which columns/values hold the needed data; exploits SQL's interactivity as a fast database interface."}, {"id": "paper_baseline_2026_acl_long_116_entity_based_schema_linking", "label": "Entity-based Schema Linking", "file_type": "concept", "source_file": "paper baseline/2026.acl-long.116.pdf", "source_location": "Sec 3.1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "paper_baseline_2026_acl_long_116_entity_based_value_retrieval", "label": "Entity-based Value Retrieval (LSH + semantic similarity)", "file_type": "concept", "source_file": "paper baseline/2026.acl-long.116.pdf", "source_location": "Sec 3.1.1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "paper_baseline_2026_acl_long_116_soft_schema_linking", "label": "Soft Schema Linking", "file_type": "concept", "source_file": "paper baseline/2026.acl-long.116.pdf", "source_location": "Sec 3.1.2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Selected columns get full detail (type, description, examples); unselected columns keep only name and type, reducing input length while tolerating linking misses."}, {"id": "paper_baseline_2026_acl_long_116_candidates_exploration", "label": "Candidates Exploration (Base and Condition SQL Probes)", "file_type": "concept", "source_file": "paper baseline/2026.acl-long.116.pdf", "source_location": "Sec 3.2.1, Fig 3, Fig 9", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "paper_baseline_2026_acl_long_116_combinations_exploration", "label": "Combinations Exploration", "file_type": "concept", "source_file": "paper baseline/2026.acl-long.116.pdf", "source_location": "Sec 3.2.2, Fig 10", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Candidate combinations returning empty results are definitely unsuitable, pruning the search space before generation."}, {"id": "paper_baseline_2026_acl_long_116_zero_shot_generation", "label": "Zero-shot Generation with Exploration Results + Self-Consistency", "file_type": "concept", "source_file": "paper baseline/2026.acl-long.116.pdf", "source_location": "Sec 3.2.3, Fig 11", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Decomposition, multi-candidate prompting and MCTS give smaller gains than supplying sufficient information; no few-shot pairs used; self-consistency over execution results."}, {"id": "paper_baseline_2026_acl_long_116_target_question_decomposition", "label": "Question as Target + Conditions", "file_type": "concept", "source_file": "paper baseline/2026.acl-long.116.pdf", "source_location": "Sec 3.2, Fig 2", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "paper_baseline_2026_acl_long_116_refinement_with_exploration", "label": "Refinement Module with Exploration", "file_type": "concept", "source_file": "paper baseline/2026.acl-long.116.pdf", "source_location": "Sec 3.3, Fig 4", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "SQLite errors carry enough feedback to fix directly; empty-result errors give no message, so the model must debug via probes like a human instead of blind regeneration."}, {"id": "paper_baseline_2026_acl_long_116_error_cause_identification", "label": "Error Cause Identification Stage (SQLGlot AST Decomposer, Sub-SQLs)", "file_type": "concept", "source_file": "paper baseline/2026.acl-long.116.pdf", "source_location": "Sec 3.3.1, Fig 8", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "paper_baseline_2026_acl_long_116_solution_exploration", "label": "Solution Exploration Stage", "file_type": "concept", "source_file": "paper baseline/2026.acl-long.116.pdf", "source_location": "Sec 3.3.2, Fig 12", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "paper_baseline_2026_acl_long_116_empty_result_error_taxonomy", "label": "Empty-Result Error Causes (condition conflict/duplication, unnecessary joins, column-value mismatch, sub-query scope inconsistency)", "file_type": "concept", "source_file": "paper baseline/2026.acl-long.116.pdf", "source_location": "Sec 3.3.2, Fig 5-6, Fig 12-13", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "paper_baseline_2026_acl_long_116_target_checking", "label": "Target Checking Module", "file_type": "concept", "source_file": "paper baseline/2026.acl-long.116.pdf", "source_location": "Sec 3.3.3, Fig 7, Fig 14", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "LLMs often add condi